DOCKER_INFLUXDB_INIT_USERNAME=user
DOCKER_INFLUXDB_INIT_PASSWORD=password
DOCKER_INFLUXDB_INIT_ORG=myorg
DOCKER_INFLUXDB_INIT_BUCKET=infldb
# Raw 5s bucket retention. 1h matches the granularity table (< 1h = raw);
# downsample-5s-to-1m consumes it every 1m, so 1h is ample. Must be >= 3600s
# (InfluxDB floor) or 0 for infinite.
DOCKER_INFLUXDB_INIT_RETENTION=1h
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=mytoken
